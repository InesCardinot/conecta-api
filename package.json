{
  "name": "conecta-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de jornadas simuladas do Conecta | Equipe 05",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test",
    "check": "node --check src/app.js && node --check src/services/analytics.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
